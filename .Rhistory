if(passandInaccurateCount==501 & passCount==501){
pass[i] = 500
fail[i] =0
inaccurate[i] = 0
}else if(passandInaccurateCount==501 & passCount!=501){
pass[i] = passCount
fail[i] = 0
inaccurate[i] = 500 - passCount
}else{
pass[i] = passCount
fail[i] = 500 - passandInaccurateCount
inaccurate[i] = passandInaccurateCount - passCount
}
}
#create cost vector

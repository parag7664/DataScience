n=500
fail <- rep(NA,1000)
pass <- rep(NA,1000)
inaccurate <- rep(NA,1000)
profit <- function(n){#function to simulate profit/loss
ofline.cost <- 100000
run.profit <- 250
run.loss <- 800
run.inaccurate <- 500
#First call the inaccurate function to bet number of pass fail and inaccurate
for (i in 1:1000) {
dev.x <- sample(c(0,0.2), n, prob = c(0.95,0.05), replace = T)# random deviation in x direction 1/20 times
dev.y <- runif(n, min=-0.05, max=0.08) # random deviation in y direction (negative bias)
cum.dev.x <- cumsum(dev.x)
cum.dev.y<- cumsum(dev.y)
cum.dev <- sqrt(cum.dev.x^2+cum.dev.y^2)
index <- 1:n
passandInaccurateCount = ifelse(is.na(index[cum.dev>=10][1]),n+1,index[cum.dev>=10][1])
passCount = ifelse(is.na(index[cum.dev>=8][1]),n+1,index[cum.dev>=8][1])
if(passandInaccurateCount==501 & passCount==501){
pass[i] = 500
fail[i] =0
inaccurate[i] = 0
}else if(passandInaccurateCount==501 & passCount!=501){
pass[i] = passCount
fail[i] = 0
inaccurate[i] = 500 - passCount
}else{
pass[i] = passCount
fail[i] = 500 - passandInaccurateCount
inaccurate[i] = passandInaccurateCount - passCount
}
}
#create cost vector
costVec <- rep(NA,1000)
for (i in 1:1000) {
if(inaccurate[i] == 0){
costVec[i] = pass[i]*run.profit
}
else if(fail[i] == 0){
costVec[i] = pass[i]*run.profit - inaccurate[i]*run.inaccurate
}else{
costVec[i] = pass[i]*run.profit - ofline.cost - run.loss*fail[i] - inaccurate[i]*run.inaccurate
}
}
hist(pass)
hist(fail)
hist(inaccurate)
summary(pass)
# sim <- replicate(1000, when.outside(n))#simulate 1000 times
# costvec <- ifelse(sim<=n, run.profit*sim-ofline.cost-run.loss*(n-sim), n*run.profit)
mean(costVec)#calculate mean profit over all simulations
}
profit(500)
hist(pass, col = "sky blue")
hist(pass, col = "sky blue")
pass

for (i in 1:1000) {
if(inaccurate[i] == 0){
costVec[i] = pass[i]*run.profit
}
else if(fail[i] == 0){
costVec[i] = pass[i]*run.profit - inaccurate[i]*run.inaccurate
}else{
costVec[i] = pass[i]*run.profit - ofline.cost - run.loss*fail[i] - inaccurate[i]*run.inaccurate
}
}
